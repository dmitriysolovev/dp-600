table sales
	lineageTag: cccad471-0ba1-4d77-b8c6-c0f31d53f135
	sourceLineageTag: [dbo].[sales]

	/// Total quantity of items sold across all transactions.
	measure 'Total Quantity' = SUM('sales'[Quantity])
		formatString: #,0
		displayFolder: Sales
		lineageTag: d074ea12-28ad-40bb-832c-3437538b2387

	/// Total net sales amount aggregated over all transactions.
	measure 'Sales Amount' = SUM('sales'[NetPrice])
		formatString: #,0.00
		displayFolder: Sales
		lineageTag: 3b19b7fb-2ea3-4425-a963-e3fc06b1490b

	/// Total cost of goods sold, calculated as unit cost times quantity.
	measure 'Total Cost' = SUMX('sales', 'sales'[UnitCost] * 'sales'[Quantity])
		formatString: #,0.00
		displayFolder: Profitability
		lineageTag: da1c3416-b78c-42d1-a21f-29569b1c4390

	/// Gross profit calculated as sales amount minus total cost.
	measure 'Gross Profit' = [Sales Amount] - [Total Cost]
		formatString: #,0.00
		displayFolder: Profitability
		lineageTag: 42de76d4-a1fb-4329-8710-06320d0f4fbe

	/// Gross margin percentage calculated as gross profit divided by sales amount.
	measure 'Gross Margin %' = DIVIDE([Gross Profit], [Sales Amount])
		formatString: 0.00 %;-0.00 %;0.00 %
		displayFolder: Profitability
		lineageTag: 23a44da9-3da2-4962-9d46-35af2b498098

	/// Average selling price per unit, calculated as sales amount divided by total quantity sold.
	measure 'Average Selling Price' = DIVIDE([Sales Amount], [Total Quantity])
		formatString: #,0.00
		displayFolder: Sales
		lineageTag: 22f875da-e179-4fef-8fc4-c0834d6b736f


	measure 'Sales PY Variance %' =
			
			VAR _pysales = CALCULATE([Sales Amount],DATEADD('Date'[Date],-1,YEAR))
			Return
			Divide([Sales Amount] - _pysales ,_pysales)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 90baebe8-0350-404f-815f-14a206831dbc

	measure 'Bikes sale %' =
			
			Var _sales = [Sales Amount] //DAX evaluates measure and saves eval result as constant value. i.e _sales = 5
			Return
			Divide(
			    CALCULATE([Sales Amount],'Product'[Category]="Bikes"), //Calculate(5,.....)
			    CALCULATE([Sales Amount],REMOVEFILTERS()))
		lineageTag: 6ed38781-4ecd-4db1-9db7-b4e1565fb26f

		annotation PBI_FormatHint = {"isGeneralNumber":true}


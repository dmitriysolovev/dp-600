	measure Orders =
			
			DISTINCTCOUNT(Sales[SalesOrderNumber])
		formatString: 0
		displayFolder: Counts
		lineageTag: 57f38fd6-cf9a-4d06-a7ee-1a306043c61b

	measure 'Order Lines' =
			
			COUNTROWS(Sales)
		formatString: 0
		displayFolder: Counts
		lineageTag: da03adc1-acfb-4d73-9aaa-b5e373c5e88f

	measure 'Sales % All Region' =
			
			DIVIDE(
				SUM(Sales[Sales]),
				CALCULATE(
					SUM(Sales[Sales]),
					REMOVEFILTERS(Region)
				)
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Ratios
		lineageTag: 008e9ca5-2758-43de-9595-76282e69f31d

	measure 'Sales % Country' =
			
			IF(
				ISINSCOPE(Region[Region]),
				DIVIDE(
					SUM(Sales[Sales]),
					CALCULATE(
						SUM(Sales[Sales]),
						REMOVEFILTERS(Region[Region])
					)
				)
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Ratios
		lineageTag: 954e603d-5c04-4a90-ad4c-8f34b04ea323

	measure 'Sales % Group' =
			
			IF(
				ISINSCOPE(Region[Region])
					|| ISINSCOPE(Region[Country]),
				DIVIDE(
					SUM(Sales[Sales]),
					CALCULATE(
						SUM(Sales[Sales]),
						REMOVEFILTERS(
							Region[Region],
							Region[Country]
						)
					)
				)
			)
		displayFolder: Ratios
		lineageTag: 565a0642-ff70-4055-95e3-f5233d204ae8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sales YTD' =
			
			TOTALYTD(SUM(Sales[Sales]), 'Date'[Date], "6-30")
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Time Intelligence
		lineageTag: a9440108-f6a0-4e23-b6c9-9fa7662ff79b

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Sales YoY Growth' =
			
			VAR SalesPriorYear =
				CALCULATE(
					SUM(Sales[Sales]),
					PARALLELPERIOD(
						'Date'[Date],
						-12,
						MONTH
					)
				)
			RETURN
				DIVIDE(
					(SUM(Sales[Sales]) - SalesPriorYear),
					SalesPriorYear
				)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Time Intelligence
		lineageTag: 5e215bb9-dc07-4caa-a171-431cb225e29a

	measure 'Selected subcategory' = SELECTEDVALUE('Product'[Subcategory])
		lineageTag: 36a5122c-fe79-4ad6-a89d-a081cf29c147

	measure 'Custom Title' = "Quantity by category in " & SELECTEDVALUE('Date'[Year],"all years")
		lineageTag: 4151a29f-1f7c-45e8-9580-4d427c8d294f

	measure 'Custom Title v2' = "Quantity by category in "& CONCATENATEX(VALUES('Date'[Year]),'Date'[Year],", ") & [Profit Margin Indicator]
		lineageTag: 7f0f8f72-0751-4699-b45a-580b57814676

	measure 'Profit Margin Indicator' =
			
			IF (
			[Profit Margin] < 0,
			"🔻",
			"✅"
			)
		lineageTag: 696890a4-fa7b-4a58-b6ce-2435707a1509

	measure 'Profit Margin SVG' = ```
			
			VAR MarginValue =
			[Profit Margin]
			 
			VAR TargetValue =
			0.10
			 
			VAR IsSuccessful =
			MarginValue >= TargetValue
			 
			VAR StatusColor =
			IF (
			IsSuccessful,
			"#16A34A",
			"#DC2626"
			)
			 
			VAR BackgroundColor =
			IF (
			IsSuccessful,
			"#F0FDF4",
			"#FEF2F2"
			)
			 
			VAR StatusText =
			IF (
			IsSuccessful,
			"ON TARGET",
			"BELOW TARGET"
			)
			 
			VAR MarginText =
			FORMAT ( MarginValue, "0.0%" )
			 
			-- Progress bar is capped at 100%
			VAR ProgressWidth =
			MIN (
			100,
			MAX ( 0, MarginValue * 100 )
			)
			 
			VAR StatusIcon =
			IF (
			IsSuccessful,
			 
			-- Green check
			"
			<circle cx='32' cy='32' r='22'
			fill='#16A34A'/>
			<path d='M21 32 L29 40 L44 24'
			fill='none'
			stroke='white'
			stroke-width='5'
			stroke-linecap='round'
			stroke-linejoin='round'/>
			",
			 
			-- Red downward arrow
			"
			<circle cx='32' cy='32' r='22'
			fill='#DC2626'/>
			<path d='M32 19 L32 40
			M23 32 L32 41 L41 32'
			fill='none'
			stroke='white'
			stroke-width='5'
			stroke-linecap='round'
			stroke-linejoin='round'/>
			"
			)
			 
			VAR SVG =
			"
			<svg xmlns='http://www.w3.org/2000/svg'
			width='300'
			height='120'
			viewBox='0 0 300 120'>
			 
			<rect x='2' y='2'
			width='296' height='116'
			rx='14'
			fill='" & BackgroundColor & "'
			stroke='" & StatusColor & "'
			stroke-width='2'/>
			 
			<!-- Status icon -->
			<g transform='translate(10 12)'>
			" & StatusIcon & "
			</g>
			 
			<!-- KPI label -->
			<text x='82' y='27'
			font-family='Segoe UI, Arial'
			font-size='13'
			font-weight='600'
			fill='#475569'>
			PROFIT MARGIN
			</text>
			 
			<!-- Margin value -->
			<text x='82' y='59'
			font-family='Segoe UI, Arial'
			font-size='28'
			font-weight='700'
			fill='" & StatusColor & "'>
			" & MarginText & "
			</text>
			 
			<!-- Status -->
			<text x='82' y='79'
			font-family='Segoe UI, Arial'
			font-size='11'
			font-weight='600'
			fill='" & StatusColor & "'>
			" & StatusText & "
			</text>
			 
			<!-- Progress-bar background -->
			<rect x='20' y='94'
			width='260' height='10'
			rx='5'
			fill='#E2E8F0'/>
			 
			<!-- Progress-bar value -->
			<rect x='20' y='94'
			width='" & FORMAT ( ProgressWidth * 2.6, "0" ) & "'
			height='10'
			rx='5'
			fill='" & StatusColor & "'/>
			 
			<!-- Target marker at 10% -->
			<line x1='46' y1='90'
			x2='46' y2='108'
			stroke='#334155'
			stroke-width='2'/>
			 
			</svg>
			"
			 
			RETURN
			"data:image/svg+xml;utf8," & SVG
			```
		lineageTag: c8b9e366-f761-48b7-83f8-17c8a9cdd3a6
		dataCategory: ImageUrl


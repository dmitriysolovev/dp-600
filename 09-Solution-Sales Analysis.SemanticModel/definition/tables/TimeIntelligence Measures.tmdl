				    SWITCH(
				        TRUE(),
				        _Value >= 1000000000, "£#,0.0,,,""B"";(£#,0.0,,,""B"");£0",
				        _Value >= 1000000, "£#,0.0,,""M"";(£#,0.0,,""M"");£0",
				        _Value >= 1000, "£#,0.0,""K"";(£#,0.0,""K"");£0",
				        "£#,##0;(£#,##0);£0"
				    )


	/// Calculates Sales Amount for the equivalent period in the previous year.
	measure 'Sales Amount PY' = CALCULATE([Sales Amount], SAMEPERIODLASTYEAR('Date'[Date]))
		displayFolder: 'Sales Amount'
		lineageTag: 35eb3d4b-3816-4c07-92eb-675a79bdd709

		formatStringDefinition =
				VAR _Value = ABS([Sales Amount PY])

table 'TimeIntelligence Measures'
	lineageTag: 947d65bd-ad88-4e63-84ad-a2ceb0f17ff6

	/// Calculates Sales Amount from the beginning of the year to the latest date in the current filter context.
	measure 'Sales Amount YTD' = TOTALYTD([Sales Amount], 'Date'[Date])
		displayFolder: 'Sales Amount'
		lineageTag: 15dd4e3c-affb-415e-8026-d50d4dbc43a9

		formatStringDefinition =
				VAR _Value = ABS([Sales Amount YTD])
				RETURN
				    SWITCH(
				        TRUE(),
				        _Value >= 1000000000, "£#,0.0,,,""B"";(£#,0.0,,,""B"");£0",
				        _Value >= 1000000, "£#,0.0,,""M"";(£#,0.0,,""M"");£0",
				        _Value >= 1000, "£#,0.0,""K"";(£#,0.0,""K"");£0",
				        "£#,##0;(£#,##0);£0"
				    )

	/// Calculates Sales Amount from the beginning of the month to the latest date in the current filter context.
	measure 'Sales Amount MTD' = TOTALMTD([Sales Amount], 'Date'[Date])
		displayFolder: 'Sales Amount'
		lineageTag: 9f3c6987-7e00-4120-874f-b1261534f98d


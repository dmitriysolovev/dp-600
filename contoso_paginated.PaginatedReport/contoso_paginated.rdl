  <DataSources>
    <DataSource Name="contoso_sales">
      <ConnectionProperties>
        <DataProvider>PBIDATASET</DataProvider>
        <ConnectString>Data Source=pbiazure://api.powerbi.com/;Identity Provider="https://login.microsoftonline.com/common, https://analysis.windows.net/powerbi/api, f0b72488-7082-488a-a7e8-eada97bd842d";Initial Catalog=sobe_wowvirtualserver-2ca3ef7a-90d6-49b4-9b05-57b6ee8bf080;Integrated Security=ClaimsToken</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>None</rd:SecurityType>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>contoso_sales</DataSourceName>
        <CommandText>DEFINE VAR __DS0Core = 
	SUMMARIZECOLUMNS(
		ROLLUPADDISSUBTOTAL(
			ROLLUPGROUP('product'[CategoryName], 'product'[SubCategoryName]), "IsGrandTotalRowTotal"
		),
		"Total_Quantity", 'sales'[Total Quantity],
		"Total_Cost", 'sales'[Total Cost],
		"Sales_Amount", 'sales'[Sales Amount]
	)

EVALUATE
	__DS0Core

ORDER BY
	[IsGrandTotalRowTotal] DESC, 'product'[CategoryName], 'product'[SubCategoryName]</CommandText>
        <wa:PreviewCommandText>DEFINE
	VAR __DS0Core = 
		SUMMARIZECOLUMNS(
			ROLLUPADDISSUBTOTAL(
				ROLLUPGROUP('product'[CategoryName], 'product'[SubCategoryName]), "IsGrandTotalRowTotal"
			),
			"Total_Quantity", 'sales'[Total Quantity],
			"Total_Cost", 'sales'[Total Cost],
			"Sales_Amount", 'sales'[Sales Amount]
		)

	VAR __DS0BodyLimited = 
		TOPN(
			500,
			__DS0Core,
			[IsGrandTotalRowTotal],
			0,
			'product'[CategoryName],
			1,
			'product'[SubCategoryName],
			1
		)

EVALUATE
	__DS0BodyLimited

ORDER BY
	[IsGrandTotalRowTotal] DESC, 'product'[CategoryName], 'product'[SubCategoryName]</wa:PreviewCommandText>
      </Query>
      <Fields>
        <Field Name="product_CategoryName">
          <DataField>product[CategoryName]</DataField>
          <AggregateIndicatorField xmlns="http://schemas.microsoft.com/sqlserver/reporting/2011/01/reportdefinition">x_5b_IsGrandTotalRowTotal_5d_</AggregateIndicatorField>
        </Field>
        <Field Name="product_SubCategoryName">
          <DataField>product[SubCategoryName]</DataField>
          <AggregateIndicatorField xmlns="http://schemas.microsoft.com/sqlserver/reporting/2011/01/reportdefinition">x_5b_IsGrandTotalRowTotal_5d_</AggregateIndicatorField>
        </Field>
        <Field Name="sales_Total_20_Quantity">
          <DataField>[Total_Quantity]</DataField>
        </Field>
        <Field Name="sales_Total_20_Cost">
          <DataField>[Total_Cost]</DataField>
        </Field>
        <Field Name="sales_Sales_20_Amount">
          <DataField>[Sales_Amount]</DataField>
        </Field>
        <Field Name="x_5b_IsGrandTotalRowTotal_5d_">
          <DataField>[IsGrandTotalRowTotal]</DataField>
        </Field>
      </Fields>
      <InterpretSubtotalsAsDetails>False</InterpretSubtotalsAsDetails>
    </DataSet>
